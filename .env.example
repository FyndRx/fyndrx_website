VITE_APP_TITLE=FyndRx
VITE_API_URL=/api/v1
VITE_APP_BASE_URL=http://localhost:3000
VITE_APP_VERSION=1.0.0

# Must match the backend's API_KEY (config/app.php `api_key`) — every request is
# rejected with 401 by ValidateApiKey middleware if this is missing or mismatched.
VITE_API_KEY=

# Google Maps API key — required for address autocomplete and map display
# (src/composables/useGoogleMaps.ts, src/components/profile/AddressSection.vue)
VITE_GOOGLE_MAPS_API_KEY=

# Social sign-in (src/composables/useSocialAuth.ts) — public client/app IDs only,
# must match the backend's GOOGLE_CLIENT_ID / FACEBOOK_APP_ID.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

VITE_APP_ENV=development

# Sentry DSN (optional — error reporting is skipped if unset)
VITE_SENTRY_DSN=

# Firebase Configuration for Web Push Notifications
# Firebase Configuration for Web Push Notifications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=